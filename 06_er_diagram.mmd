    BRANDS ||--o{ LEADS : "receives inquiries"
    BRANDS ||--o{ ENROLMENTS : "admits learners"
    BRANDS ||--o{ INVOICES : "issues bills"
    BRANDS ||--o{ CERTIFICATES : "awards credentials"

    USERS ||--o{ USER_ROLES : "assigned roles"
    USERS ||--o{ STAFF_PROFILES : "staff details"
    USERS ||--o{ STUDENT_PROFILES : "student details"

    COURSES ||--o{ COURSE_MODULES : "contains"
    COURSE_MODULES ||--o{ COURSE_LESSONS : "contains"
    COURSES ||--o{ BATCHES : "instantiates"

    BATCHES ||--o{ CLASS_SESSIONS : "schedules"
    CLASS_SESSIONS ||--o{ CLASS_ATTENDANCE : "tracks presence"

